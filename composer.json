{
    "name": "laikait/laika-route",
    "description": "Routing package for Laika PHP MVC Framework.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Laika IT",
            "email": "strblackhawk@gmail.com"
        },
        {
            "name": "Showket Ahmed",
            "email": "riyadhtayf@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "Laika\\Route\\": "src/"
        }
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^4.0.2",
        "phpcompatibility/php-compatibility": "dev-develop",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "compat": "phpcs --standard=phpcs.xml --report=full"
    }
}
